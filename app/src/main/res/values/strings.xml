    <string name="settings_seek_previews">Seek previews</string>
    <string name="settings_seek_previews_desc">Show a preview frame while skipping a video</string>
    <string name="settings_seek_previews_caption">Opens a second connection to the stream; some providers may refuse it. Applies to the next video you open.</string>
    <string name="settings_hero_previews">Hero previews</string>
    <string name="settings_hero_previews_desc">Play a muted preview while the Home banner is focused</string>
    <string name="settings_still_watching_caption">Pauses and asks if you are still present after a period of inactivity, and stops playback if no response is received. Applies to the next video you open.</string>
    <string name="settings_player_clock">Player clock</string>
    <string name="settings_player_clock_desc">Show the clock in the player overlay</string>
    <string name="settings_advanced_caption">Settings most users rarely need to change. Defaults work well for most TVs.</string>
    <string name="settings_buffer_caption">Higher buffers improve stability but increase channel-switching delay.</string>
    <string name="settings_refresh_sync">Refresh sync</string>
    <string name="settings_refresh_sync_desc">Retune the TV to the video\'s refresh rate for smoother film motion.</string>
    <string name="settings_refresh_sync_caption">Applies to the next video you open; the screen may briefly blank while the TV switches.</string>
    <string name="settings_tunneled_video">Tunneled video</string>
    <string name="settings_tunneled_video_desc">Allow the TV to decode and time video for smoother high-bitrate playback.</string>
    <string name="settings_tunneled_video_caption">Works on some TVs only. If picture or sound drifts or freezes, disable it. Applies to the next video you open.</string>
    <string name="settings_audio_offload">Audio offload</string>
    <string name="settings_audio_offload_desc">Decode compatible audio on the TV\'s DSP to reduce power consumption.</string>
    <string name="settings_audio_offload_caption">Applies to the next video you open; formats the DSP cannot handle still play normally.</string>
    <string name="settings_video_enhance">Video enhancement</string>
    <string name="settings_video_enhance_desc">Deband and sharpen each frame to smooth low-bitrate video.</string>
    <string name="settings_video_enhance_caption">Applies to the next video you open. Provides smoother gradients and crisper edges at some GPU cost. Tunneled video is ignored while active.</string>
    <string name="settings_faster_live">Faster live start</string>
    <string name="settings_faster_live_desc">Request low-latency output from the video decoder for live channels.</string>
    <string name="settings_faster_live_caption">Used only where the device\'s decoder supports it. Applies to the next channel you open; disable if live video shows glitches.</string>
    <string name="settings_dv7">Native Dolby Vision 7</string>
    <string name="settings_dv7_desc">Play Profile 7 using the device\'s own decoder, avoiding conversion.</string>
    <string name="settings_dv7_caption">Effective only when the device has a Profile 7 decoder and the TV supports Dolby Vision. Applies to the next video you open.</string>
    <string name="settings_truehd">TrueHD / Atmos bitstream</string>
    <string name="settings_truehd_desc">Send Dolby TrueHD to your receiver as a lossless MAT stream.</string>
    <string name="settings_truehd_caption">Requires an HDMI receiver that accepts TrueHD. Applies to the next video you open; disable if audio drops out.</string>
    <string name="settings_controls">Controls</string>
    <string name="settings_controls_desc">Launcher and boot controls, and mapping of remote keys.</string>
    <string name="settings_dns_blocking">DNS blocking</string>
    <string name="settings_dns_blocking_desc">Private DNS ad blocking.</string>
    <string name="settings_backup_restore">Backup &amp; restore</string>
    <string name="settings_backup_restore_desc">Move your configuration via code, the phone companion, or TV sync.</string>
